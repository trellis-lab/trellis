{
    "name": "trellis-preview",
    "displayName": "Trellis Mermaid Preview",
    "description": "High-quality Mermaid diagram preview powered by the Trellis renderer (VLSI-grade orthogonal routing).",
    "version": "0.1.0",
    "publisher": "trellis",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/trellis/trellis"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "mermaid",
        "diagram",
        "preview",
        "flowchart",
        "UML"
    ],
    "icon": "media/icon.png",
    "activationEvents": [
        "onLanguage:mermaid"
    ],
    "main": "./out/extension",
    "contributes": {
        "languages": [
            {
                "id": "mermaid",
                "aliases": [
                    "Mermaid",
                    "mermaid"
                ],
                "extensions": [
                    ".mmd",
                    ".mermaid"
                ]
            }
        ],
        "commands": [
            {
                "command": "trellis.openPreview",
                "title": "Trellis: Open Preview",
                "icon": "$(open-preview)"
            },
            {
                "command": "trellis.openPreviewToSide",
                "title": "Trellis: Open Preview to the Side",
                "icon": "$(open-preview)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "trellis.openPreviewToSide",
                    "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "trellis.openPreview",
                    "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "trellis.openPreviewToSide",
                "key": "ctrl+shift+v",
                "mac": "cmd+shift+v",
                "when": "editorLangId == mermaid"
            }
        ],
        "configuration": {
            "title": "Trellis",
            "properties": {
                "trellis.autoPreview": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically update the preview when the diagram source changes."
                },
                "trellis.showEdgeLabels": {
                    "type": "boolean",
                    "default": true,
                    "description": "Display labels on diagram edges."
                },
                "trellis.showTitle": {
                    "type": "boolean",
                    "default": true,
                    "description": "Display the diagram title above the diagram."
                },
                "trellis.crossingStyle": {
                    "type": "string",
                    "default": "Skip",
                    "enum": ["None", "Arc", "Rectangular", "Skip"],
                    "enumDescriptions": [
                        "Edges pass through each other with no decoration.",
                        "The crossing edge hops over with a smooth arc.",
                        "The crossing edge hops over with a square bump.",
                        "The crossing edge stroke breaks at the crossing point."
                    ],
                    "description": "How edges are drawn when they cross each other."
                },
                "trellis.cornerRadius": {
                    "type": "number",
                    "default": 8,
                    "minimum": 0,
                    "maximum": 32,
                    "description": "Corner roundness of node shapes in pixels. Set to 0 for sharp corners."
                },
                "trellis.labelFontSize": {
                    "type": "number",
                    "default": 10,
                    "minimum": 6,
                    "maximum": 24,
                    "description": "Font size in pixels for edge labels."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "package": "vsce package --no-dependencies",
        "build-wasm": "cd ../.. && ./scripts/build-wasm.sh"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "^24.10.0",
        "typescript": "^5.3.0",
        "@vscode/vsce": "^2.22.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "eslint": "^8.0.0"
    }
}