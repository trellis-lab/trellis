<!-- editors/intellij/src/main/resources/META-INF/plugin.xml -->
<idea-plugin>
    <id>com.trellis.plugin</id>
    <name>Trellis Mermaid Preview</name>
    <vendor url="https://github.com/trellis/trellis">Trellis</vendor>
    <version>0.1.0</version>

    <description><![CDATA[
        <p>Live preview for <code>.mmd</code> / <code>.mermaid</code> diagram files.</p>
        <ul>
            <li>Renders diagrams instantly as you type using the Trellis WASM engine.</li>
            <li>Supports flowchart, class, ER, and C4 diagram types.</li>
            <li>Opens in a dedicated Tool Window – no browser required.</li>
        </ul>
    ]]></description>

    <idea-version since-build="243"/>

    <!-- ── Required platform features ──────────────────────────────────────── -->
    <depends>com.intellij.modules.platform</depends>

    <!-- ── Extensions ───────────────────────────────────────────────────────── -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool window that hosts the JCEF preview panel -->
        <toolWindow
            id="Trellis Preview"
            anchor="right"
            secondary="false"
            icon="/icons/trellis_toolwindow.svg"
            factoryClass="com.trellis.plugin.PreviewToolWindowFactory"/>

        <!-- Project-level service that owns the WasmBridge lifecycle -->
        <projectService
            serviceInterface="com.trellis.plugin.WasmBridge"
            serviceImplementation="com.trellis.plugin.WasmBridge"/>

        <!-- Application-level service for plugin settings -->
        <applicationService
            serviceInterface="com.trellis.plugin.TrellisSettings"
            serviceImplementation="com.trellis.plugin.TrellisSettings"/>

        <!-- VFS listener registered at project open -->
        <projectService
            serviceInterface="com.trellis.plugin.MmdFileListener"
            serviceImplementation="com.trellis.plugin.MmdFileListener"/>

    </extensions>

    <!-- ── Actions ──────────────────────────────────────────────────────────── -->
    <actions>
        <!-- "Open Trellis Preview" in the editor context menu -->
        <action
            id="com.trellis.plugin.OpenPreviewAction"
            class="com.trellis.plugin.OpenPreviewAction"
            text="Open Trellis Preview"
            description="Open the Trellis live preview for this .mmd file"
            icon="/icons/trellis_toolwindow.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut first-keystroke="control shift M" keymap="$default"/>
        </action>

        <!-- "Export Diagram" action (PNG/SVG – deferred to Mc milestone) -->
        <action
            id="com.trellis.plugin.ExportAction"
            class="com.trellis.plugin.ExportAction"
            text="Export Trellis Diagram…"
            description="Export the current diagram as PNG or SVG">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <!-- ── Plugin startup listener ─────────────────────────────────────────── -->
    <applicationListeners>
        <listener
            class="com.trellis.plugin.TrellisPlugin"
            topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <projectListeners>
        <listener
            class="com.trellis.plugin.MmdFileListener"
            topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

</idea-plugin>
