# docker/Dockerfile.intellij
#
# Multi-stage build that produces the Trellis IntelliJ plugin .zip.
#
# Stages:
#   wasm-builder    – Rust toolchain + wasm-pack → bundler WASM artefacts
#   plugin-builder  – JDK 17 + Gradle → Kotlin compile + buildPlugin
#   artifact        – Minimal Alpine image that copies the .zip to /output
#
# Usage (from repo root):
#   docker build -f docker/Dockerfile.intellij -t trellis-ij-builder .
#   docker run --rm -v "$(pwd)/dist:/output" trellis-ij-builder
#
# The plugin .zip will be written to ./dist/trellis-intellij-plugin-*.zip

# ══════════════════════════════════════════════════════════════════════════════
# Stage 1 – WASM builder (bundler target for Chicory / JVM classpath)
# ══════════════════════════════════════════════════════════════════════════════
FROM rust:1.93.1-slim-bookworm AS wasm-builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install wasm-pack
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

# Add the wasm32 compilation target
RUN rustup target add wasm32-unknown-unknown

WORKDIR /build

# ── Dependency pre-caching ────────────────────────────────────────────────────
# Copy workspace manifests + create dummy lib sources so `cargo fetch` can
# resolve and download all crates without compiling real code.
COPY Cargo.toml Cargo.lock ./
COPY crates/trellis-parser/Cargo.toml  crates/trellis-parser/Cargo.toml
COPY crates/trellis-core/Cargo.toml    crates/trellis-core/Cargo.toml
COPY crates/trellis-wasm/Cargo.toml    crates/trellis-wasm/Cargo.toml
COPY crates/trellis-cli/Cargo.toml     crates/trellis-cli/Cargo.toml
COPY tests/benchmarks/Cargo.toml       tests/benchmarks/Cargo.toml
COPY tests/integration/Cargo.toml      tests/integration/Cargo.toml

RUN mkdir -p \
    crates/trellis-parser/src \
    crates/trellis-core/src \
    crates/trellis-wasm/src \
    crates/trellis-cli/src \
    tests/benchmarks/src \
    tests/integration/src \
    && echo 'fn main() {}' > crates/trellis-cli/src/main.rs \
    && touch \
    crates/trellis-parser/src/lib.rs \
    crates/trellis-core/src/lib.rs \
    crates/trellis-wasm/src/lib.rs \
    tests/benchmarks/src/lib.rs \
    tests/integration/src/lib.rs

RUN cargo fetch --target wasm32-unknown-unknown

# ── Real source ───────────────────────────────────────────────────────────────
COPY crates/ crates/

# Build WASM with the bundler target.
# The bundler target generates a CommonJS-compatible module that is loaded by
# the Chicory runtime from the JVM classpath – it does NOT require a browser.
# --out-dir must be absolute (wasm-pack resolves relative to the crate, not WORKDIR).
RUN wasm-pack build \
    --release \
    --target bundler \
    --out-dir /wasm-out \
    --out-name trellis_wasm \
    crates/trellis-wasm

# ══════════════════════════════════════════════════════════════════════════════
# Stage 2 – IntelliJ plugin builder
# ══════════════════════════════════════════════════════════════════════════════
# gradle:8.10-jdk17 ships JDK 17 + Gradle 8.10; no wrapper needed.
FROM gradle:9.3-jdk17 AS plugin-builder

WORKDIR /plugin

# ── Gradle dependency pre-caching ─────────────────────────────────────────────
# Copy only the build scripts first.  Gradle will download:
#   • Kotlin stdlib + compiler
#   • Gradle IntelliJ Plugin (org.jetbrains.intellij.platform)
#   • IntelliJ IDEA Community IDE (~700 MB, cached as a Docker layer)
#   • Chicory runtime JAR
# This layer is reused on every build unless build.gradle.kts changes.
COPY editors/intellij/build.gradle.kts    .
COPY editors/intellij/settings.gradle.kts .

# Create a minimal placeholder source so Gradle can resolve all dependencies
# (including the IntelliJ Platform download) without needing real Kotlin files.
RUN mkdir -p src/main/kotlin/com/trellis/plugin \
    && echo 'package com.trellis.plugin' \
    > src/main/kotlin/com/trellis/plugin/Placeholder.kt

# Download all dependencies (IDE + plugins) – this is the slow step (~2 min
# on first run, then fully cached in the Docker layer cache).
RUN gradle dependencies --no-daemon --stacktrace 2>&1 | tail -5 || true

# ── Real plugin sources ───────────────────────────────────────────────────────
# Now overlay the real Kotlin sources and resources.
COPY editors/intellij/src ./src

# Place the WASM artefacts produced in stage 1 onto the JVM classpath.
# Chicory loads /wasm/trellis_wasm_bg.wasm from the plugin's resource root.
COPY --from=wasm-builder /wasm-out ./src/main/resources/wasm/

# ── Build the plugin ──────────────────────────────────────────────────────────
RUN gradle buildPlugin --no-daemon --stacktrace

# ══════════════════════════════════════════════════════════════════════════════
# Stage 3 – Minimal artifact image
# ══════════════════════════════════════════════════════════════════════════════
FROM alpine:3.20

COPY --from=plugin-builder /plugin/build/distributions/*.zip /artifact/

# When run with  -v /host/dist:/output  the .zip is copied to the host.
ENTRYPOINT ["sh", "-c", \
    "set -e; \
    src=$(ls /artifact/*.zip | head -1); \
    dest=\"/output/$(basename $src)\"; \
    cp \"$src\" \"$dest\"; \
    echo \"Plugin ZIP extracted → $dest\""]
